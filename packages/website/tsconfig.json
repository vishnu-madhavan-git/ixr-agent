{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",
        "noEmit": false,
        "allowImportingTsExtensions": false,
        "baseUrl": ".",
        "outDir": "dist",
        "paths": {
            // Self root
            "@/*": ["src/*"],

            "@ixr/llms": ["../llms/src/index.ts"],
            "@ixr/page-controller": ["../page-controller/src/PageController.ts"],
            "@ixr/core": ["../core/src/IXRAgentCore.ts"],
            "@ixr/ui": ["../ui/src/index.ts"],

            "ixr-agent": ["../ixr-agent/src/IXRAgent.ts"]
        }
    },
    "include": ["**/*.ts", "**/*.tsx"],
    "exclude": ["dist", "node_modules"],
    "references": [
        //
        { "path": "../llms" },
        { "path": "../page-controller" },
        { "path": "../core" },
        { "path": "../ui" },

        { "path": "../ixr-agent" }
    ]
}
