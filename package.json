{
  "name": "ixr-agent-root",
  "private": true,
  "version": "1.5.2",
  "type": "module",
  "workspaces": [
    "packages/ixr-controller",
    "packages/ui",
    "packages/llms",
    "packages/core",
    "packages/ixr-agent",
    "packages/extension",
    "packages/website"
  ],
  "description": "IXR Agent - GUI Agent for IXR web applications",
  "author": "Simon<gaomeng1900>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/alibaba/ixr-agent.git"
  },
  "homepage": "https://alibaba.github.io/ixr-agent/",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "scripts": {
    "cleanup": "rm -rf packages/*/dist",
    "start": "npm run dev --workspace=@ixr/website",
    "build:website": "npm run build:website --workspace=@ixr/website",
    "build:libs": "npm run build --workspaces --if-present",
    "build": "npm run build:libs && npm run build:website",
    "dev:demo": "npm run dev:demo --workspace=ixr-agent",
    "version": "node scripts/sync-version.js",
    "lint": "eslint .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.2",
    "@commitlint/config-conventional": "^20.4.2",
    "@eslint/js": "^9.39.2",
    "@microsoft/api-extractor": "^7.58.9",
    "@tailwindcss/vite": "^4.3.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^25.3.3",
    "@vitejs/plugin-react-swc": "^4.3.1",
    "chalk": "^5.6.2",
    "concurrently": "^9.2.1",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-dom": "^2.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "eslint-plugin-react-x": "^2.13.0",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.1",
    "prettier": "^3.8.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.61.1",
    "unplugin-dts": "^1.0.2",
    "vite": "^7.3.1",
    "vite-plugin-css-injected-by-js": "^4.0.1",
    "vite-bundle-analyzer": "^1.3.8"
  },
  "overrides": {
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*.{js,ts,cjs,cts,mjs,mts}": [
      "npx prettier --write --ignore-unknown",
      "npx eslint --quiet"
    ],
    "*.{jsx,tsx}": [
      "npx prettier --write --ignore-unknown",
      "npx eslint --quiet"
    ],
    "*.css": [
      "npx prettier --write --ignore-unknown"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "rules": {
      "subject-case": [
        0,
        "never"
      ]
    }
  },
  "prettier": {
    "singleQuote": true,
    "semi": false,
    "useTabs": true,
    "printWidth": 100,
    "trailingComma": "es5",
    "plugins": [
      "@trivago/prettier-plugin-sort-imports"
    ],
    "importOrder": [
      "<THIRD_PARTY_MODULES>",
      "^(@/).*(?<!css)$",
      "^[./].*(?<!css)$",
      ".css$"
    ],
    "importOrderSeparation": true,
    "importOrderSortSpecifiers": true,
    "overrides": [
      {
        "files": "*.md",
        "options": {
          "useTabs": false,
          "tabWidth": 4
        }
      },
      {
        "files": "*.json",
        "options": {
          "useTabs": false,
          "tabWidth": 4
        }
      }
    ]
  }
}